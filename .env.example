# ==========================================
# APLICAÇÃO
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# JWT (Autenticação)
# ==========================================
JWT_SECRET=troque_isto_por_uma_chave_bem_grande_e_aleatoria
JWT_EXPIRES_IN=7d

# ==========================================
# POSTGRESQL + PGVECTOR
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=llm_app
DB_PASSWORD=troque_esta_senha
DB_DATABASE=llm_app_db

# ==========================================
# REDIS (Fila BullMQ)
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# OLLAMA (Runtime de Inferência - LOCAL, nunca exposto)
# ==========================================
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_0
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ==========================================
# FILA DE INFERÊNCIA
# ==========================================
QUEUE_CONCURRENCY=2
QUEUE_JOB_TIMEOUT_MS=300000
