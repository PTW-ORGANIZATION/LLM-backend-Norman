# ==========================================
# APLICAÇÃO
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# JWT (Autenticação)
# ==========================================
JWT_SECRET=troque_isto_por_uma_chave_bem_grande_e_aleatoria
JWT_EXPIRES_IN=7d

# ==========================================
# POSTGRESQL + PGVECTOR
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=llm_app
DB_PASSWORD=troque_esta_senha
DB_DATABASE=llm_app_db

# ==========================================
# REDIS (Fila BullMQ)
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Autenticação do Redis. Vazia só é aceitável num Redis que não sai de
# localhost: a fila carrega identificador de documento e de cliente, e um Redis
# aberto na rede entrega isso a quem alcançar a porta.
REDIS_PASSWORD=

# ==========================================
# OLLAMA (Runtime de Inferência - LOCAL, nunca exposto)
# ==========================================
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_0
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Modelo de visão, usado para OCR de PDF escaneado.
OLLAMA_VISION_MODEL=minicpm-v

# ==========================================
# FILA DE INFERÊNCIA
# ==========================================
QUEUE_CONCURRENCY=2
QUEUE_JOB_TIMEOUT_MS=300000

# ==========================================
# INGESTÃO DE DOCUMENTOS
# ==========================================
# Base da rota interna do Norman que devolve os bytes de um arquivo.
NORMAN_INTERNAL_URL=
INGESTION_QUEUE_CONCURRENCY=1
INGESTION_FETCH_TIMEOUT_MS=120000
# OCR custa mais de um minuto por página: o teto evita que um PDF longo
# segure a fila.
INGESTION_OCR_MAX_PAGES=20
INGESTION_OCR_TIMEOUT_MS=180000
INGESTION_OCR_SCALE=2
# Slide de deck que veio como arte exportada tambem passa por OCR, com teto
# proprio de imagens por arquivo.
INGESTION_SLIDE_OCR_MAX_IMAGES=20
# Os extratores de formato binario (.doc, .xls, .pptx) carregam o arquivo
# inteiro em memoria: este teto e o que separa um acervo pesado de um worker
# morto por falta de memoria.
INGESTION_MAX_FILE_BYTES=104857600
INGESTION_MAX_EXPANDED_FILE_BYTES=314572800
INGESTION_MAX_SHEETS=100
INGESTION_MAX_SLIDES=300
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=150
INGESTION_EMBED_BATCH_SIZE=16

# ==========================================
# ESTUDO DO ACERVO
# ==========================================
# Notas e dossiê saem em fila própria: é trabalho de GPU mais caro que a
# vetorização e a vazão dele se regula em separado.
KNOWLEDGE_QUEUE_CONCURRENCY=1
KNOWLEDGE_EXCERPT_MAX_CHARS=12000
KNOWLEDGE_STUDY_TIMEOUT_MS=180000
KNOWLEDGE_DOSSIER_DELAY_MS=60000
KNOWLEDGE_DOSSIER_MAX_DOCUMENTS=25

# Índice do banco do Redis. Duas instâncias do serviço no mesmo Redis com o mesmo
# índice compartilham as filas do BullMQ e roubam job uma da outra. Use um índice
# por ambiente (0 = produção, 1 = develop, por exemplo).
REDIS_DB=0

# ==========================================
# GATEWAY DE GERAÇÃO (contrato interno)
# ==========================================
# Teto de duração de uma chamada ao provedor de geração.
GATEWAY_TIMEOUT_MS=120000
# Teto do teste administrativo de conexão. Mais curto que a geração: quem está
# na tela esperando o resultado não espera dois minutos para saber que a
# credencial não vale.
GATEWAY_CONNECTION_TEST_TIMEOUT_MS=15000

# ==========================================
# CONSUMIDORES INTERNOS
# ==========================================
# O token que identifica o Norman nas rotas /internal. Sem ele, nenhuma chamada
# interna passa — um segredo em branco não vira porta aberta.
INTERNAL_API_TOKEN=
# Outras aplicações que podem usar o gateway, no formato
# `nome:VARIAVEL_DO_TOKEN:operacao1|operacao2:escopos`, separadas por vírgula.
# O token mora na variável nomeada, nunca no valor desta lista. Uma aplicação
# nova não herda nada: sem operação declarada ela não gera, e sem o escopo
# `client` ela não alcança conhecimento de cliente.
# Exemplo: niprofe:NIPROFE_INTERNAL_TOKEN:job_insights:person
INTERNAL_CONSUMERS=

# ==========================================
# CONEXÕES DE PROVEDOR
# ==========================================
# As credenciais dos provedores moram AQUI, e não no Norman: o plano de controle
# do Norman manda a chave lógica da conexão e a revisão, nunca URL nem segredo.
# Conexão sem as variáveis abaixo aparece como indisponível na administração,
# com o nome da variável que falta — ausência de configuração nunca aparece como
# sucesso.
#
# O Norman NÃO tem GROK_API_KEY nem OPENAI_API_KEY. Removê-las do ambiente dele
# não impede testar, escolher modelo nem ativar uma conexão: o que atravessa é
# metadado público (disponibilidade, modelo padrão, allowlist e revisões
# reconhecidas). Chave duplicada é chave a mais para vazar, girar e divergir.
#
# Mudar qualquer variável de uma conexão muda o digest do provisionamento dela e
# invalida as revisões já reconhecidas: elas precisam ser sincronizadas de novo
# (o teste pela tela administrativa do Norman faz isso).

# Ollama (local). Já tem padrão e por isso costuma estar provisionada.
OLLAMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
# Allowlist de modelos escolhíveis pelo administrador. Vazia deixa só o padrão.
OLLAMA_ALLOWED_MODELS=

# OpenAI. Indisponível enquanto não for provisionada.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ALLOWED_MODELS=

# Grok (xAI). Indisponível enquanto não for provisionada. A chave anterior foi
# considerada exposta: use uma substituta, provisionada só aqui.
GROK_BASE_URL=https://api.x.ai/v1
GROK_API_KEY=
GROK_MODEL=
GROK_ALLOWED_MODELS=

# ==========================================
# RETENÇÃO
# ==========================================
# Não há padrão, de propósito. Prazo de retenção é decisão de quem responde
# pelos dados, e um número inventado aqui decidiria no lugar dessa pessoa.
# Sujeito sem prazo NÃO é varrido, e a pendência aparece em /health e no log da
# subida. Preencher a variável é o que liga a limpeza daquele sujeito.
#
# Áudio temporário e transcrição vivem no Norman; auditoria de geração e
# conversas são limpas aqui.
RETENTION_TEMPORARY_AUDIO_DAYS=
RETENTION_TRANSCRIPT_DAYS=
RETENTION_CONVERSATION_DAYS=
RETENTION_GENERATION_AUDIT_DAYS=
# Intervalo entre varreduras e teto de linhas por varredura.
RETENTION_SWEEP_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=5000
